# Copy to server/.env and fill in local values. Never commit server/.env.
NODE_ENV=development
PORT=3000
# Bind to localhost in development. On the company host, bind to the LAN/VPN interface
# behind the HTTPS reverse proxy. Never expose PostgreSQL to the internet.
HOST=127.0.0.1

# PostgreSQL connection (local development database with synthetic data only)
DATABASE_URL=postgres://fleetora:CHANGE_ME@127.0.0.1:5432/fleetora_dev
# Used only by the automated tests. Its data is wiped by every test run.
TEST_DATABASE_URL=postgres://fleetora:CHANGE_ME@127.0.0.1:5432/fleetora_test

# Origin(s) allowed to make state-changing requests, comma separated.
# Vite dev server default: http://localhost:5173
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Session cookie. COOKIE_SECURE must be true whenever the app is served over HTTPS
# (always the case in production). It defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Login protection
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_MINUTES=15

# Set to "true" only when running behind a trusted reverse proxy (e.g. on the company host)
TRUST_PROXY=false

LOG_LEVEL=info

# Optional: absolute or relative path to the built frontend (web/dist) to serve it
# from the API process on the same origin.
WEB_DIST_DIR=

# Private file storage (vehicle documents and photos). Keep it OUTSIDE the web root and back it up
# with the database. On Railway, point it to a mounted volume (e.g. /data/files).
STORAGE_DIR=uploads
# Maximum size of one uploaded file, in megabytes.
MAX_UPLOAD_MB=10

# Backups (BACKUP_RESTORE.md, issue #14). Set these ONLY in the environment of the backup job on the
# company host — real values never go into Git. Placeholders below.
# BACKUP_DIR=/srv/fleetora-backups            # another disk than STORAGE_DIR
# BACKUP_PASSPHRASE=change-me-generate-20-plus-characters
# BACKUP_KEY_LABEL=2026-11
# OFFSITE_KIND=dir                            # or s3
# OFFSITE_DIR=/mnt/offsite-disk/fleetora
# OFFSITE_S3_BUCKET=example-private-bucket
# OFFSITE_S3_REGION=example-region
# OFFSITE_S3_ENDPOINT=https://s3.example.invalid
# OFFSITE_S3_PREFIX=fleetora/
# OFFSITE_S3_ACCESS_KEY_ID=placeholder
# OFFSITE_S3_SECRET_ACCESS_KEY=placeholder
# BACKUP_KEEP_LOCAL=true
# DRILL_ADMIN_DATABASE_URL=postgres://user:password@localhost:5432/postgres
# App server: warn the manager when no off-site copy / restore drill is recorded (default: production).
# BACKUP_OFFSITE_REQUIRED=true
